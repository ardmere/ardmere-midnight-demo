# Copy to .env (gitignored). Do not commit real secrets.
# No keys are invented by the demo scripts — supply your own.

# Required for Preprod node RPC + indexer (Blockfrost Midnight Preprod project)
BLOCKFROST_PROJECT_ID=

# Wallet: set EXACTLY ONE of these (do not invent in CI)
# Lace-compatible BIP-39 seed is 128 hex characters; or pass the 24-word phrase.
MIDNIGHT_WALLET_SEED=
# MIDNIGHT_WALLET_MNEMONIC=

# midnight-js private-state store (≥ 16 characters)
PRIVATE_STATE_PASSWORD=

# After deploy, set the contract address for publish / attest / read
CONTRACT_ADDRESS=

# Derived by `npm run wallet:address` (public; the matching seed stays above).
# Paste this into the faucet — it must be the unshielded mn_addr_preprod1... form.
MIDNIGHT_WALLET_ADDRESS=

# Proof server — default is Midnight hosted Preprod (no Docker):
#   https://proof-server.preprod.midnight.network
# Privacy: witness data is sent to that host. Override to local if preferred:
# MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
# MIDNIGHT_PROOF_SERVER_URL=https://proof-server.preprod.midnight.network

# Optional faucet override (default: https://midnight-tmnight-preprod.nethermind.dev/)
# MIDNIGHT_FAUCET_URL=
