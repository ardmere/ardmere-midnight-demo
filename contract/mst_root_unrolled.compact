    assert(Mst_isPadding(btcPos[0], btcNeg[0], ethPos[0], ethNeg[0], usdtPos[0], usdtNeg[0]) || Mst_navPositive(btcPos[0], btcNeg[0], ethPos[0], ethNeg[0], usdtPos[0], usdtNeg[0], priceBtc, priceEth, priceUsdt), "negative nav at 0");
