//
// Jubjub Schnorr verification polyfill for Compact toolchain 0.31.1
// (Preprod / ledger-v8). That stdlib does not export jubjubSchnorrVerify /
// JubjubSchnorrSignature; ledger-9 toolchains do, but they are not deployable
// to Preprod. Challenge truncation and EC check match the zk-loan / Midnight
// expert polyfill pattern (Fiat–Shamir via transientHash, c mod 2^248).

pragma language_version 0.23;

module schnorr {
  import CompactStandardLibrary;

  export struct SchnorrSignature {
    announcement: JubjubPoint;
    response: Field;
  }

  struct SchnorrHashInput<#n> {
    ann_x: Field;
    ann_y: Field;
    pk_x: Field;
    pk_y: Field;
    msg: Vector<n, Field>;
  }

  witness getSchnorrReduction(challengeHash: Field): [Field, Uint<248>];

  circuit challenge<#n>(
    msg: Vector<n, Field>,
    announcement: JubjubPoint,
    pk: JubjubPoint
  ): Field {
    return transientHash<SchnorrHashInput<n>>(
      SchnorrHashInput<n> {
        ann_x: jubjubPointX(announcement),
        ann_y: jubjubPointY(announcement),
        pk_x: jubjubPointX(pk),
        pk_y: jubjubPointY(pk),
        msg: msg
      }
    );
  }

  circuit truncateChallenge(cFull: Field): Field {
    const TWO_248: Field =
      452312848583266388373324160190187140051835877600158453279131187530910662656 as Field;
    const [q, cTruncated] = getSchnorrReduction(cFull);
    assert(
      disclose(q) * TWO_248 + (disclose(cTruncated) as Field) == cFull,
      "Invalid challenge reduction"
    );
    return disclose(cTruncated) as Field;
  }

  export circuit schnorrVerify<#n>(
    msg: Vector<n, Field>,
    signature: SchnorrSignature,
    pk: JubjubPoint
  ): [] {
    // Identity-point rejection: stdlib jubjubSchnorrVerify does this; polyfill
    // asserts the public key is not the default/identity JubjubPoint.
    const identity: JubjubPoint = default<JubjubPoint>;
    assert(
      !(jubjubPointX(pk) == jubjubPointX(identity) &&
        jubjubPointY(pk) == jubjubPointY(identity)),
      "publisherPk must not be the identity"
    );
    const c: Field = truncateChallenge(challenge<n>(msg, signature.announcement, pk));
    const lhs: JubjubPoint = ecMulGenerator(signature.response);
    const rhs: JubjubPoint = ecAdd(signature.announcement, ecMul(pk, c));
    assert(
      jubjubPointX(lhs) == jubjubPointX(rhs) && jubjubPointY(lhs) == jubjubPointY(rhs),
      "Invalid attestation signature"
    );
  }

  // Exported for off-chain signing parity via compiled pureCircuits.
  export pure circuit schnorrChallenge(
    ann_x: Field,
    ann_y: Field,
    pk_x: Field,
    pk_y: Field,
    msg: Vector<3, Field>
  ): Field {
    return transientHash<SchnorrHashInput<3>>(
      SchnorrHashInput<3> {
        ann_x: ann_x,
        ann_y: ann_y,
        pk_x: pk_x,
        pk_y: pk_y,
        msg: msg
      }
    );
  }
}
