{
  "name": "ardmere-midnight-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Standardized Midnight ZK-PoR hackathon MVP — Merkle Sum batch snapshot on Preprod (Wave 3 demo archived)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23 || >=24"
  },
  "scripts": {
    "compile": "compact compile contract/por_snapshot.compact contract/managed/por_snapshot",
    "compile:mst": "compact compile contract/mst_hash.compact contract/managed/mst_hash && npx tsx scripts/generate-mst-unrolled.compact.ts && compact compile contract/mst_root_unrolled.compact contract/managed/mst_root_unrolled && compact compile contract/mst_bundle.compact contract/managed/mst_bundle",
    "compile:standard-por": "npm run compile:mst && compact compile contract/standard_por.compact contract/managed/standard_por",
    "generate:mst-fixtures": "tsx scripts/generate-mst-fixtures.ts",
    "build-mst": "tsx scripts/build-mst.ts",
    "submit-snapshot": "tsx src/submitSnapshot.ts --dry-run",
    "verify-inclusion": "tsx src/verifyInclusion.ts",
    "read:por": "tsx src/readPor.ts",
    "undeployed:deploy-submit": "tsx src/undeployedDeploySubmit.ts",
    "generate:fixtures": "tsx scripts/generate-fixtures.ts",
    "test": "tsx --test test/*.test.ts",
    "test:encode": "tsx --test test/encode.test.ts",
    "test:inclusion": "tsx --test test/inclusion.test.ts",
    "keys": "tsx src/keys.ts",
    "tree": "tsx src/tree.ts",
    "sign": "tsx src/sign.ts",
    "publish": "tsx src/publish.ts",
    "attest": "tsx src/attest.ts",
    "read": "tsx src/read.ts",
    "wallet:address": "tsx src/wallet.ts",
    "wallet:balance": "tsx src/walletBalance.ts",
    "proof:health": "tsx src/proofHealth.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@midnight-ntwrk/midnight-js-compact": "^4.1.1",
    "@midnight-ntwrk/testkit-js": "^4.1.1",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
